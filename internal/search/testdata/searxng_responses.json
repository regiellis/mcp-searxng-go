   {
    "title": "Unlocking biological insight from single-cell data with an interpretable dual-stream foundation model.",
    "img_src": "",
    "iframe_src": "",
    "audio_src": "",
    "thumbnail": "",
    "publishedDate": "2026-07-06T00:00:00",
    "pubdate": "2026-07-06 00:00:00",
    "length": null,
    "views": "",

  "query": "transformer attention",
  "results": [
   {
    "title": "Dilated Neighborhood Attention Transformer",
    "img_src": "",
    "iframe_src": "",
    "audio_src": "",
    "thumbnail": "",
    "publishedDate": "2022-09-29T17:57:08",
